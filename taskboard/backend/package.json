{
	"name": "taskboard-backend",
	"version": "1.0.0",
	"description": "REST API для мини-трекера задач",
	"private": true,
	"type": "commonjs",
	"main": "dist/server.js",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "tsx watch --env-file=.env src/server.ts",
		"migrate:dev": "tsx --env-file=.env src/db/migrate.ts",
		"typecheck": "tsc --noEmit",
		"clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
		"build": "npm run clean && tsc",
		"start": "node dist/server.js",
		"migrate": "node dist/db/migrate.js"
	},
	"dependencies": {
		"express": "^5.2.1",
		"pg": "^8.23.1",
		"pino": "^10.3.1",
		"pino-http": "^11.0.0"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/node": "^22.20.5",
		"@types/pg": "^8.23.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
